# Ginto AI Docker Environment Configuration
# Copy this file to .env in the project root: cp docker/.env.example .env

# =============================================================================
# Database Configuration
# =============================================================================
DB_NAME=ginto
DB_USER=ginto
DB_PASS=secret
DB_ROOT_PASS=rootsecret

# =============================================================================
# LLM Provider API Keys (set at least one)
# =============================================================================

# Groq - Fast inference (recommended)
GROQ_API_KEY=

# Cerebras - Ultra-fast inference
CEREBRAS_API_KEY=

# OpenAI - GPT models
OPENAI_API_KEY=

# Anthropic - Claude models
ANTHROPIC_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Fireworks AI
FIREWORKS_API_KEY=

# =============================================================================
# Application Configuration
# =============================================================================

# Provider to use (auto-detected if not set)
# Options: groq, cerebras, openai, anthropic, together, fireworks
LLM_PROVIDER=

# Web search provider: 'lightpanda' (default) or 'groq'
# - lightpanda: Use our Lightpanda headless browser (works with ANY LLM provider)
# - groq: Use Groq's built-in browser_search (requires Groq provider, GPT-OSS model)
# Lightpanda is 11x faster than Chrome and works with Cerebras, OpenAI, etc.
SEARCH_PROVIDER=lightpanda

# Application environment: development, staging, production
APP_ENV=production

# Enable debug mode (set to true for development)
APP_DEBUG=false

# =============================================================================
# Network Configuration
# =============================================================================

# HTTP port (default: 80)
HTTP_PORT=80

# HTTPS port (default: 443)
HTTPS_PORT=443

# =============================================================================
# HTTPS / Domain Configuration (for production)
# =============================================================================

# Your domain name (e.g., ginto.example.com)
CADDY_DOMAIN=localhost

# Email for Let's Encrypt SSL certificates
TLS_EMAIL=

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# Docker Sandbox Configuration
# =============================================================================

# Sandbox mode: 'docker', 'lxd', or 'auto' (auto-detects best option)
# - docker: Use Docker containers for sandboxes (works on macOS, Windows, Linux)
# - lxd: Use LXD containers (Linux only, requires LXD installation)
# - auto: Prefer LXD if available, fall back to Docker
SANDBOX_MODE=docker

# Docker network subnet for sandboxes
# This subnet is used for deterministic IP allocation
DOCKER_SANDBOX_SUBNET=172.30.0.0/16

# Secret key for IP permutation (change in production for security)
# Used for collision-free deterministic IP allocation
IP_PERMUTATION_KEY=ginto-default-key-change-in-prod

# =============================================================================
# Advanced Configuration
# =============================================================================

# Skip database wait during startup (for debugging)
SKIP_DB_WAIT=false

# Run database migrations on startup
RUN_MIGRATIONS=true

# PHP memory limit
PHP_MEMORY_LIMIT=512M

# PHP max execution time
PHP_MAX_EXECUTION_TIME=300
